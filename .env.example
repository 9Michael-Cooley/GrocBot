# Copy to .env. Everything here maps onto the config tree: GROKBOT_<PATH>, with
# __ as the path separator. Env wins over the config file, CLI flags win over env.

# Checkpoint directory. Unset => synthetic backend.
GROKBOT_WEIGHTS=

# Logging. 'json' is what the cluster ran.
GROKBOT_LOG_LEVEL=info
GROKBOT_LOG_FORMAT=human

# Scheduler. Do not exceed 384 on grok-3 (GROK-4417).
GROKBOT_SCHEDULER__MAX_RUNNING=384
GROKBOT_SCHEDULER__CHUNK_SIZE=2048

# Cache. fp8 halves KV memory; see GROK-3980 before enabling.
GROKBOT_CACHE__DTYPE=auto
GROKBOT_CACHE__PREFIX_CACHING=true

# Safety. The classifier isn't in this tree and fails open by default —
# set this to 'block' for anything reachable.
GROKBOT_SAFETY__ON_CLASSIFIER_ERROR=block
GROKBOT_TELEMETRY__LOG_PROMPTS=false

# Tracing. Collector endpoint was stripped at extraction.
GROKBOT_TELEMETRY__TRACING=false
GROKBOT_OTLP_ENDPOINT=
